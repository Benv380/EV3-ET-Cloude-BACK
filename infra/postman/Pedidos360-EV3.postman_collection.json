                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Prueba de fraude (Runner: 1000 iteraciones)",
      "item": [
        {
          "name": "Crear pedido (ráfaga)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/pedidos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pedidos"
              ]
            },
            "description": "Ejecutar con el Runner: Iterations 1000, Delay 0 ms. Resultado esperado: ~10 × 201 y luego 403.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente\": \"Cliente Postman {{n}}\",\n  \"emailCliente\": \"postman{{n}}@ejemplo.cl\",\n  \"descripcion\": \"Pedido de prueba de carga #{{n}}\",\n  \"total\": \"{{total}}\",\n  \"simularFallo\": \"NINGUNA\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Datos distintos en cada iteración del Runner",
                  "const n = pm.info.iteration + 1;",
                  "pm.variables.set('n', n);",
                  "pm.variables.set('total', Math.floor(10000 + Math.random() * 90000));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const codigo = pm.response.code;",
                  "const ok = (pm.collectionVariables.get('creados') | 0);",
                  "const bloq = (pm.collectionVariables.get('bloqueados') | 0);",
                  "if (codigo === 201) { pm.collectionVariables.set('creados', ok + 1); }",
                  "if (codigo === 403) { pm.collectionVariables.set('bloqueados', bloq + 1); }",
                  "",
                  "pm.test('Respuesta esperada: 201 (creado) o 403 (bloqueado por posible fraude)', () => {",
                  "    pm.expect([201, 403]).to.include(codigo);",
                  "});",
                  "if (codigo === 403) {",
                  "    pm.test('El 403 indica bloqueo por posible fraude', () => {",
                  "        const pd = pm.response.json();",
                  "        pm.expect(pd.title).to.include('fraude');",
                  "        pm.expect(pd.regla).to.be.a('string');",
                  "    });",
                  "}",
                  "console.log(`#${pm.info.iteration + 1} -> ${codigo} | creados=${pm.collectionVariables.get('creados')} bloqueados=${pm.collectionVariables.get('bloqueados')}`);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Ver y quitar el bloqueo",
      "item": [
        {
          "name": "Bloqueos activos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/analitica/bloqueos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "analitica",
                "bloqueos"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const lista = pm.response.json();",
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const vigente = lista.find(b => b.vigente);",
                  "if (vigente) { pm.collectionVariables.set('usuario', vigente.usuario); }",
                  "pm.test('Hay un usuario bloqueado por posible fraude', () => pm.expect(vigente).to.exist);"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear pedido estando bloqueado → 403",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/pedidos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pedidos"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente\": \"Cliente bloqueado\",\n  \"emailCliente\": \"bloqueado@ejemplo.cl\",\n  \"descripcion\": \"Debe rechazarse\",\n  \"total\": 1000,\n  \"simularFallo\": \"NINGUNA\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('pedidos-service rechaza al usuario bloqueado (403)', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Desbloquear usuario",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/analitica/bloqueos/{{usuario}}/desbloquear",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "analitica",
                "bloqueos",
                "{{usuario}}",
                "desbloquear"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Desbloqueo publicado (200)', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('creados', '0');",
                  "pm.collectionVariables.set('bloqueados', '0');"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
